#! /usr/bin/python3

import gpiozero
import rclpy
from rclpy.node import Node

from std_msgs.msg import Float32

class PumpNode(Node):
    def __init__(self, pump_id):
        super().__init__(f'pump_{pump_id}_controller')
        self.pump_id = pump_id

        
        self.air_pump1 = gpiozero.OutputDevice(16)

        # Suscriptor para recibir comandos
        self.subscription = self.create_subscription(
            Float32,
            f'pump_{self.pump_id}/time_command',
            self.pump_callback,
            10
        )

        # Atributo para el temporizador
        self.current_timer = None
        self.pump_active = False  # Estado de la bomba

        self.get_logger().info(f'Pump {self.pump_id} Controller Node is running.')

    def pump_callback(self, msg):
        duration = msg.data
        if duration > 0:
            self.get_logger().info(f'Pump {self.pump_id} ON for {duration} seconds')

            # Cancelar temporizador actual si existe
            if self.current_timer:
                self.current_timer.cancel()

            # Encender la bomba y crear un nuevo temporizador
            self.start_pump()
            self.current_timer = self.create_timer(duration, self.stop_pump_once)
        else:
            self.stop_pump()

    def start_pump(self):
        if not self.pump_active:
            self.air_pump1.on()
            self.pump_active = True
            self.get_logger().info(f'Pump {self.pump_id} is now ON.')

    def stop_pump_once(self):
        if self.pump_active:
            self.air_pump1.off()
            self.pump_active = False
            self.get_logger().info(f'Pump {self.pump_id} is now OFF.')

        # Cancelar el temporizador actual
        if self.current_timer:
            self.current_timer.cancel()
            self.current_timer = None

    def destroy_node(self):
        # GPIO.cleanup(self.pump_gpio)
        self.get_logger().info(f'Pump {self.pump_id} GPIO cleaned up.')
        super().destroy_node()

def main(args=None):
    rclpy.init(args=args)
    pump_id = 1  # Cambia a 2 para la segunda bomba
    node = PumpNode(pump_id)
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
